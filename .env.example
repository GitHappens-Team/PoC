# Copied to apps/web/.env.local by `pnpm bootstrap` (which also fills in the values below).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Auth (Better Auth). Generate a real secret with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me
AUTH_BASE_URL=http://localhost:3000
# Production only: proxies in front of the app (IPs/CIDRs, comma-separated) so rate limiting sees real client IPs,
# and/or the header your platform sets with the client IP (e.g. x-real-ip).
# TRUSTED_PROXIES=
# CLIENT_IP_HEADER=

# Required in production. Leave RESEND_API_KEY unset in dev to send through Mailpit (http://localhost:8025) instead.
RESEND_API_KEY=
EMAIL_FROM="Your App <noreply@example.com>"

SMTP_HOST=localhost
SMTP_PORT=1025
