{
  "name": "saas-boilerplate",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "brand": "node scripts/brand.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "logos": "pnpm --filter web logos",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:studio": "pnpm --filter @repo/db studio",
    "infra:up": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/dev/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/dev/docker-compose.yml down -v"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
